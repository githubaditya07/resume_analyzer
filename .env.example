# Optional database override. By default, the app creates a local SQLite database.
# DATABASE_URL="file:./.local-data/careerlens.db"

# Optional for deployment. Local runs generate and persist a secret automatically.
# NEXTAUTH_SECRET="replace-with-a-random-secret-before-deployment"
NEXTAUTH_URL="http://localhost:3000"

DEMO_MODE="true"
UPLOAD_MAX_SIZE_MB="5"
ANALYSIS_RATE_LIMIT_PER_HOUR="5"

# Optional: seed an administrator explicitly with a unique, strong password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Placement administrator"
